# ============================================================
# k8s-secrets.env — Kubernetes secret values for kustomize
# ============================================================
# DO NOT commit the real k8s-secrets.env file to Git.
# Copy this file to k8s-secrets.env and fill in real values.
#
#   cp k8s-secrets.env.example k8s-secrets.env
#   # edit k8s-secrets.env with your actual credentials
# ============================================================

# JWT signing secret (long random string)
JWT_SECRET=your-jwt-secret-here

# Webhook payload encryption key (base64-encoded 32-byte key)
WEBHOOK_SECRET_ENCRYPTION_KEY=your-webhook-secret-encryption-key-here

# Vault master key (base64-encoded 32-byte key)
VAULT_MASTER_KEY=your-vault-master-key-here

# GitHub Personal Access Token for Spring Cloud Config Server
GIT_USERNAME=your-github-username
GIT_CONFIG_REPO=https://github.com/your-org/your-config-repo
GIT_PASSWORD=your-github-personal-access-token

# PostgreSQL root password
POSTGRES_PASSWORD=your-postgres-root-password

# Per-service DB passwords
MERCHANT_DB_PASSWORD=your-merchant-db-password
PAYMENT_DB_PASSWORD=your-payment-db-password
OPERATIONS_DB_PASSWORD=your-operations-db-password
VAULT_DB_PASSWORD=your-vault-db-password

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password
